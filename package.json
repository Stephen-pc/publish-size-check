{
  "name": "publish-size-check",
  "version": "2.3.0",
  "description": "发布尺寸检查：对照目标平台规格，检查图片能不能发、哪一项参数过不了。零依赖，只查几何参数。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "SKILL.md",
    "scripts",
    "references",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "skill",
    "publish",
    "image",
    "dpi",
    "aspect-ratio",
    "xiaohongshu",
    "wechat",
    "print",
    "no-dependencies"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stephen-pc/publish-size-check.git"
  },
  "homepage": "https://github.com/Stephen-pc/publish-size-check",
  "bugs": {
    "url": "https://github.com/Stephen-pc/publish-size-check/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "selftest": "node tools/dsh-selftest.mjs"
  }
}
